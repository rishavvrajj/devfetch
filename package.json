{
  "name": "devfetch",
  "version": "0.1.1",
  "description": "Fast, beautiful CLI overview of your developer environment, project, Git state, and local security hygiene.",
  "type": "module",
  "license": "MIT",
  "author": "Rishav Raj <rishav5raj3@gmail.com>",
  "homepage": "https://github.com/rishavvrajj/devfetch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rishavvrajj/devfetch.git"
  },
  "bugs": {
    "url": "https://github.com/rishavvrajj/devfetch/issues",
    "email": "rishav5raj3@gmail.com"
  },
  "private": false,
  "keywords": [
    "cli",
    "cli-tool",
    "developer-tools",
    "terminal",
    "system-info",
    "git",
    "security",
    "developer-experience",
    "bun"
  ],
  "bin": {
    "devfetch": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "typecheck": "bun x tsc --noEmit",
    "build": "bun build ./src/cli.ts --outdir ./dist --target node --external commander --external picocolors --external ink --external react --external react/jsx-runtime --external react/jsx-dev-runtime",
    "compile": "bun build ./src/cli.ts --compile --outfile devfetch",
    "test": "bun test",
    "check": "bun run typecheck && bun run test && bun run build",
    "prepublishOnly": "bun run build && bun run test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.7",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "ink": "^5.2.1",
    "picocolors": "^1.1.1",
    "react": "^18.3.1"
  }
}
